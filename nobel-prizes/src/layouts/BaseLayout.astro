---
import "../styles/global.css";

const { title = "Nobel Prize Explorer" } = Astro.props;

const categories = [
  ["Chemistry", "chemistry"],
  ["Economic Sciences", "economic-sciences"],
  ["Literature", "literature"],
  ["Peace", "peace"],
  ["Physics", "physics"],
  ["Physiology or Medicine", "physiology-or-medicine"],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Explore Nobel Prizes and Laureates." />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-title" href="/">Nobel Prize Explorer</a>
      <nav aria-label="Main navigation">
        <ul>
          <li><a href="/">Home</a></li>
          {categories.map(([name, slug]) => (
            <li><a href={`/category/${slug}/`}>{name}</a></li>
          ))}
        </ul>
      </nav>
    </header>

    <main class="page-content">
      <slot />
    </main>

    <footer class="site-footer">
      <p>Explore Nobel Prizes and Laureates</p>
    </footer>
  </body>
</html>